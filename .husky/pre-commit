#!/bin/bash

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM "*.js" "*.jsx" | sed 's| |\\ |g')


if [[ "$STAGED_FILES" = "" ]]; then
 echo -e "\t\033[32mNo JavaScript files to lint\033[0m"
 else
   echo "Linting JavaScript files..."


   # Run ESLint on staged files
   ./node_modules/eslint/bin/eslint.js $STAGED_FILES


   # If there were any lint errors, exit with non-zero status code
   if [[ $? -ne 0 ]]; then
     echo -e "\t\033[41mLint errors found in staged files. Aborting commit.\033[0m"
     exit 1
   else
     echo -e "\t\033[32mLint Check Passed\033[0m"
   fi
fi


